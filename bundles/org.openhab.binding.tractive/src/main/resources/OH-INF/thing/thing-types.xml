<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="tractive"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<!-- ==================== BRIDGE: Account ==================== -->

	<bridge-type id="account">
		<label>Tractive Account</label>
		<description>Connects to the Tractive cloud using your account credentials. All tracker things require this bridge.</description>

		<config-description>
			<parameter name="email" type="text" required="true">
				<context>email</context>
				<label>Email</label>
				<description>Tractive account email address</description>
			</parameter>
			<parameter name="password" type="text" required="true">
				<context>password</context>
				<label>Password</label>
				<description>Tractive account password</description>
			</parameter>
		</config-description>
	</bridge-type>

	<!-- ==================== THING: Dog 6 Tracker ==================== -->

	<thing-type id="dog-6">
		<supported-bridge-type-refs>
			<bridge-type-ref id="account"/>
		</supported-bridge-type-refs>

		<label>Tractive Dog 6</label>
		<description>A Tractive Dog 6 GPS pet tracker. Provides real-time location, battery, health data, and commands.</description>

		<channel-groups>
			<channel-group id="position" typeId="position-group"/>
			<channel-group id="hardware" typeId="hardware-group"/>
			<channel-group id="commands" typeId="commands-group"/>
			<channel-group id="health" typeId="health-group"/>
			<channel-group id="dog" typeId="dog-group"/>
		</channel-groups>

		<config-description>
			<parameter name="trackerId" type="text" required="true" min="8" max="8">
				<label>Tracker ID</label>
				<description>8-character Tractive tracker hardware ID (e.g. "HBDYUFSC")</description>
			</parameter>
			<parameter name="trackedPetId" type="text" required="true">
				<label>Pet ID</label>
				<description>Tractive pet (trackable object) ID linked to this tracker</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" unit="s" min="0">
				<label>Refresh Interval</label>
				<description>How often to re-poll tracker details from the REST API (seconds). Set to 0 to disable — real-time
					updates arrive via the channel regardless.</description>
				<default>0</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</thing-type>

	<!-- ==================== CHANNEL GROUPS ==================== -->

	<channel-group-type id="position-group">
		<label>Position</label>
		<channels>
			<channel id="location" typeId="system.location"/>
			<channel id="last-position-time" typeId="last-position-time"/>
			<channel id="speed" typeId="speed"/>
			<channel id="sensor-used" typeId="sensor-used"/>
			<channel id="position-accuracy" typeId="position-accuracy"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="hardware-group">
		<label>Hardware</label>
		<channels>
			<channel id="battery-level" typeId="system.battery-level"/>
			<channel id="charging-state" typeId="charging-state"/>
			<channel id="battery-state" typeId="battery-state"/>
			<channel id="tracker-state" typeId="tracker-state"/>
			<channel id="last-contact" typeId="last-contact"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="commands-group">
		<label>Commands</label>
		<channels>
			<channel id="buzzer" typeId="buzzer"/>
			<channel id="led" typeId="led"/>
			<channel id="live-tracking" typeId="live-tracking"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="health-group">
		<label>Health</label>
		<channels>
			<channel id="activity-recorded" typeId="activity-recorded"/>
			<channel id="activity-goal" typeId="activity-goal"/>
			<channel id="sleep-day" typeId="sleep-day"/>
			<channel id="sleep-night" typeId="sleep-night"/>
			<channel id="sleep-calm" typeId="sleep-calm"/>
			<channel id="resting-heart-rate-status" typeId="resting-heart-rate-status"/>
			<channel id="resting-respiratory-rate-status" typeId="resting-respiratory-rate-status"/>
			<channel id="unseen-health-alerts" typeId="unseen-health-alerts"/>
			<channel id="activity-synced-at" typeId="activity-synced-at"/>
			<channel id="scratch" typeId="scratch-status"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="dog-group">
		<label>Dog</label>
		<channels>
			<channel id="bark" typeId="bark-status"/>
		</channels>
	</channel-group-type>

	<!-- ==================== CHANNEL TYPES: Position ==================== -->

	<channel-type id="last-position-time">
		<item-type>DateTime</item-type>
		<label>Last Position Time</label>
		<description>Time of the most recent position report</description>
		<tags>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="speed">
		<item-type>Number:Speed</item-type>
		<label>Speed</label>
		<description>Current movement speed (null when stationary)</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Speed</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="sensor-used" advanced="true">
		<item-type>String</item-type>
		<label>Sensor Used</label>
		<description>Positioning sensor used for the last fix (GPS, KNOWN_WIFI, PHONE)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="position-accuracy">
		<item-type>Number:Length</item-type>
		<label>Position Accuracy</label>
		<description>Estimated position uncertainty in metres (always 30 for KNOWN_WIFI)</description>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

	<!-- ==================== CHANNEL TYPES: Hardware ==================== -->

	<channel-type id="charging-state">
		<item-type>String</item-type>
		<label>Charging State</label>
		<description>Current charging state (e.g. CHARGING, NOT_CHARGING)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="battery-state" advanced="true">
		<item-type>String</item-type>
		<label>Battery State</label>
		<description>Battery health state (e.g. FULL, REGULAR, LOW)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="tracker-state" advanced="true">
		<item-type>String</item-type>
		<label>Tracker State</label>
		<description>Operational state of the tracker (e.g. OPERATIONAL)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="last-contact">
		<item-type>DateTime</item-type>
		<label>Last Contact</label>
		<description>Time of the most recent successful contact with this tracker, via REST poll or real-time channel event</description>
		<tags>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<!-- ==================== CHANNEL TYPES: Commands ==================== -->

	<channel-type id="buzzer">
		<item-type>Switch</item-type>
		<label>Buzzer</label>
		<description>Activates or deactivates the tracker buzzer</description>
		<tags>
			<tag>Control</tag>
		</tags>
	</channel-type>

	<channel-type id="led">
		<item-type>Switch</item-type>
		<label>LED</label>
		<description>Activates or deactivates the tracker LED</description>
		<tags>
			<tag>Control</tag>
			<tag>Light</tag>
		</tags>
	</channel-type>

	<channel-type id="live-tracking">
		<item-type>Switch</item-type>
		<label>Live Tracking</label>
		<description>Enables or disables live tracking mode (higher GPS update rate)</description>
		<tags>
			<tag>Control</tag>
		</tags>
	</channel-type>

	<!-- ==================== CHANNEL TYPES: Health ==================== -->

	<channel-type id="activity-recorded">
		<item-type>Number:Time</item-type>
		<label>Active Time</label>
		<description>Total time of activity recorded today</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Duration</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="activity-goal">
		<item-type>Number:Time</item-type>
		<label>Activity Goal</label>
		<description>Daily activity time goal</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Duration</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="sleep-day">
		<item-type>Number:Time</item-type>
		<label>Daytime Sleep</label>
		<description>Total time of daytime sleep today</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Duration</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="sleep-night">
		<item-type>Number:Time</item-type>
		<label>Night Sleep</label>
		<description>Total time of night-time sleep today</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Duration</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="sleep-calm">
		<item-type>Number:Time</item-type>
		<label>Calm Time</label>
		<description>Total time of calm (resting but not sleep) today</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Duration</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="resting-heart-rate-status">
		<item-type>String</item-type>
		<label>Heart Rate Status</label>
		<description>Heart rate status from health overview (e.g. NORMAL)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="resting-respiratory-rate-status">
		<item-type>String</item-type>
		<label>Respiratory Rate Status</label>
		<description>Respiratory rate status from health overview (e.g. NORMAL)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="unseen-health-alerts" advanced="true">
		<item-type>Number</item-type>
		<label>Unseen Health Alerts</label>
		<description>Number of unseen health alerts</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="activity-synced-at" advanced="true">
		<item-type>DateTime</item-type>
		<label>Activity Synced At</label>
		<description>Time when the activity data was last synced from the tracker</description>
		<tags>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="bark-status">
		<item-type>String</item-type>
		<label>Bark Status</label>
		<description>Bark detection status from health overview (e.g. INFREQUENT, CALCULATING_BASELINE)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="scratch-status">
		<item-type>String</item-type>
		<label>Scratch Status</label>
		<description>Scratch detection status from health overview (e.g. INFREQUENT, NOT_ENOUGH_DATA_TODAY)</description>
		<state readOnly="true"/>
	</channel-type>

</thing:thing-descriptions>
